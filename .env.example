# URL pubblico del sito, senza barra finale: serve a canonical, hreflang e sitemap.xml generati in fase di BUILD.
# Obbligatorio per la build (su Cloudflare Pages, se manca, si usa l'URL dell'anteprima).
SITE_URL=https://www.example.com

# Dominio usato dal profilo prod-tls (Caddy) per il certificato Let's Encrypt automatico
DOMAIN=example.com

# Endpoint del form contatti (es. Formspree). Se vuoto, il form apre un'email precompilata.
# Attenzione: questa variabile viene inglobata nel bundle in fase di BUILD (vedi README).
VITE_FORM_ENDPOINT=
